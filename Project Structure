## `supabase/migrations/0001_init.sql` (starter tables)
```sql
create table courses (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references auth.users not null,
  title text not null,
  term text,
  syllabus_raw_text text,
  created_at timestamptz default now()
);

create table assignments (
  id uuid primary key default gen_random_uuid(),
  course_id uuid references courses on delete cascade,
  title text not null,
  description text,
  status text default 'todo' check (status in ('todo','in_progress','review','done')),
  due_date date,
  estimated_hours numeric,
  ai_generated boolean default false,
  parent_assignment_id uuid references assignments,
  created_at timestamptz default now()
);

create table skills (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references auth.users not null,
  name text not null,
  category text
);

create table learning_items (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references auth.users not null,
  title text not null,
  source text,
  status text default 'want_to_learn' check (status in ('want_to_learn','learning','practicing','mastered')),
  linked_skill_id uuid references skills,
  linked_assignment_id uuid references assignments,
  created_at timestamptz default now()
);

create table career_goals (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references auth.users not null,
  title text not null,
  job_posting_raw_text text,
  generated_roadmap jsonb,
  created_at timestamptz default now()
);

-- Row Level Security: every table scoped to the owning user
alter table courses enable row level security;
alter table assignments enable row level security;
alter table skills enable row level security;
alter table learning_items enable row level security;
alter table career_goals enable row level security;

create policy "Users manage own courses" on courses
  for all using (auth.uid() = user_id);
create policy "Users manage own learning items" on learning_items
  for all using (auth.uid() = user_id);
create policy "Users manage own skills" on skills
  for all using (auth.uid() = user_id);
create policy "Users manage own career goals" on career_goals
  for all using (auth.uid() = user_id);
create policy "Users manage own assignments" on assignments
  for all using (
    exists (select 1 from courses where courses.id = assignments.course_id and courses.user_id = auth.uid())
  );
```

