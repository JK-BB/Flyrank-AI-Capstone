// lib/ai/groq.ts — Groq client wrapper
// ============================================
import { createGroq } from '@ai-sdk/groq';

export const groq = createGroq({
  apiKey: process.env.GROQ_API_KEY,
});

export const MODEL = groq('llama-3.3-70b-versatile');


// ============================================
// lib/ai/breakdownAssignment.ts
// ============================================
import { generateObject } from 'ai';
import { z } from 'zod';
import { MODEL } from './groq';

const subtaskSchema = z.object({
  subtasks: z.array(
    z.object({
      title: z.string(),
      estimated_hours: z.number(),
    })
  ),
});

export async function breakdownAssignment(title: string, description: string) {
  const { object } = await generateObject({
    model: MODEL,
    schema: subtaskSchema,
    prompt: `Break this assignment into 3-6 concrete subtasks with realistic time estimates in hours.

Title: ${title}
Description: ${description}

Return only the subtasks.`,
  });

  return object.subtasks;
}


// ============================================
// app/api/assignments/[id]/breakdown/route.ts
// ============================================
import { NextRequest, NextResponse } from 'next/server';
import { createClient } from '@/lib/supabase/server';
import { breakdownAssignment } from '@/lib/ai/breakdownAssignment';

export async function POST(
  req: NextRequest,
  { params }: { params: { id: string } }
) {
  const supabase = createClient();

  const { data: assignment, error } = await supabase
    .from('assignments')
    .select('*')
    .eq('id', params.id)
    .single();

  if (error || !assignment) {
    return NextResponse.json({ error: { message: 'Assignment not found' } }, { status: 404 });
  }

  const subtasks = await breakdownAssignment(
    assignment.title,
    assignment.description ?? ''
  );

  const rows = subtasks.map((s) => ({
    course_id: assignment.course_id,
    parent_assignment_id: assignment.id,
    title: s.title,
    estimated_hours: s.estimated_hours,
    ai_generated: true,
    status: 'todo',
  }));

  const { data: created, error: insertError } = await supabase
    .from('assignments')
    .insert(rows)
    .select();

  if (insertError) {
    return NextResponse.json({ error: { message: insertError.message } }, { status: 500 });
  }

  return NextResponse.json({ data: created }, { status: 201 });
}


