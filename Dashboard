// ============================================
// app/(app)/dashboard/page.tsx
// Server component: fetches everything in parallel, passes to client widgets
// ============================================
import { createClient } from '@/lib/supabase/server';
import { DeadlinesWidget } from '@/components/dashboard/DeadlinesWidget';
import { LearningWidget } from '@/components/dashboard/LearningWidget';
import { WeeklySummaryWidget } from '@/components/dashboard/WeeklySummaryWidget';

export default async function DashboardPage() {
  const supabase = createClient();

  const [deadlinesRes, learningRes, summaryRes] = await Promise.all([
    supabase
      .from('assignments')
      .select('id, title, due_date, status, courses(title)')
      .not('due_date', 'is', null)
      .neq('status', 'done')
      .order('due_date', { ascending: true })
      .limit(5),
    supabase
      .from('learning_items')
      .select('id, title, status')
      .in('status', ['learning', 'practicing'])
      .order('created_at', { ascending: false })
      .limit(5),
    supabase
      .from('weekly_summaries')
      .select('summary_text, highlights, week_start')
      .order('week_start', { ascending: false })
      .limit(1)
      .maybeSingle(),
  ]);

  return (
    <div className="space-y-6">
      <h1 className="text-xl font-semibold">Dashboard</h1>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <DeadlinesWidget deadlines={deadlinesRes.data ?? []} />
        <LearningWidget items={learningRes.data ?? []} />
        <WeeklySummaryWidget summary={summaryRes.data} />
      </div>
    </div>
  );
}


// ============================================
// components/dashboard/DeadlinesWidget.tsx
// ============================================
type Deadline = {
  id: string;
  title: string;
  due_date: string;
  status: string;
  courses: { title: string } | null;
};

function daysUntil(dateStr: string) {
  const diff = new Date(dateStr).getTime() - Date.now();
  return Math.ceil(diff / (1000 * 60 * 60 * 24));
}

export function DeadlinesWidget({ deadlines }: { deadlines: Deadline[] }) {
  return (
    <div className="rounded-lg border p-4">
      <h2 className="font-medium text-sm mb-3">Upcoming Deadlines</h2>
      {deadlines.length === 0 ? (
        <p className="text-sm text-muted-foreground">Nothing due soon 🎉</p>
      ) : (
        <ul className="space-y-2">
          {deadlines.map((d) => {
            const days = daysUntil(d.due_date);
            const urgent = days <= 2;
            return (
              <li key={d.id} className="flex items-center justify-between text-sm">
                <div>
                  <p className="font-medium">{d.title}</p>
                  <p className="text-xs text-muted-foreground">{d.courses?.title}</p>
                </div>
                <span className={urgent ? 'text-red-600 font-medium' : 'text-muted-foreground'}>
                  {days === 0 ? 'Today' : days < 0 ? 'Overdue' : `${days}d`}
                </span>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  );
}


// ============================================
// components/dashboard/LearningWidget.tsx
// ============================================
type LearningItem = {
  id: string;
  title: string;
  status: string;
};

const STATUS_LABEL: Record<string, string> = {
  learning: 'Learning',
  practicing: 'Practicing',
};

export function LearningWidget({ items }: { items: LearningItem[] }) {
  return (
    <div className="rounded-lg border p-4">
      <h2 className="font-medium text-sm mb-3">Active Learning</h2>
      {items.length === 0 ? (
        <p className="text-sm text-muted-foreground">
          Nothing in progress — add something in Growth Mode.
        </p>
      ) : (
        <ul className="space-y-2">
          {items.map((item) => (
            <li key={item.id} className="flex items-center justify-between text-sm">
              <span>{item.title}</span>
              <span className="text-xs rounded-full bg-muted px-2 py-0.5">
                {STATUS_LABEL[item.status] ?? item.status}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}


// ============================================
// components/dashboard/WeeklySummaryWidget.tsx
// ============================================
'use client';

import { useState } from 'react';

type Summary = {
  summary_text: string;
  highlights: string[];
  week_start: string;
} | null;

export function WeeklySummaryWidget({ summary }: { summary: Summary }) {
  const [current, setCurrent] = useState(summary);
  const [loading, setLoading] = useState(false);

  async function generate() {
    setLoading(true);
    const res = await fetch('/api/summaries/generate', { method: 'POST' });
    if (res.ok) {
      const { data } = await res.json();
      setCurrent(data);
    }
    setLoading(false);
  }

  return (
    <div className="rounded-lg border p-4">
      <div className="flex items-center justify-between mb-3">
        <h2 className="font-medium text-sm">This Week</h2>
        <button
          onClick={generate}
          disabled={loading}
          className="text-xs underline text-muted-foreground disabled:opacity-50"
        >
          {loading ? 'Generating…' : current ? 'Regenerate' : 'Generate'}
        </button>
      </div>

      {!current ? (
        <p className="text-sm text-muted-foreground">
          No summary yet this week.
        </p>
      ) : (
        <>
          <p className="text-sm">{current.summary_text}</p>
          {current.highlights?.length > 0 && (
            <ul className="mt-2 space-y-1">
              {current.highlights.map((h, i) => (
                <li key={i} className="text-xs text-muted-foreground">
                  • {h}
                </li>
              ))}
            </ul>
          )}
        </>
      )}
    </div>
  );
}


// ============================================
// app/api/summaries/generate/route.ts
// ============================================
import { NextResponse } from 'next/server';
import { createClient } from '@/lib/supabase/server';
import { generateWeeklySummary } from '@/lib/ai/generateSummary';

export async function POST() {
  const supabase = createClient();
  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (!user) {
    return NextResponse.json({ error: { message: 'Not authenticated' } }, { status: 401 });
  }

  const weekStart = new Date();
  weekStart.setDate(weekStart.getDate() - weekStart.getDay());
  const weekStartStr = weekStart.toISOString().split('T')[0];

  const [{ data: doneAssignments }, { data: masteredItems }] = await Promise.all([
    supabase
      .from('assignments')
      .select('title')
      .eq('status', 'done')
      .gte('created_at', weekStartStr),
    supabase
      .from('learning_items')
      .select('title')
      .eq('status', 'mastered')
      .gte('created_at', weekStartStr),
  ]);

  const { summary_text, highlights } = await generateWeeklySummary({
    completedAssignments: doneAssignments?.map((a) => a.title) ?? [],
    masteredSkills: masteredItems?.map((i) => i.title) ?? [],
  });

  const { data, error } = await supabase
    .from('weekly_summaries')
    .upsert(
      {
        user_id: user.id,
        week_start: weekStartStr,
        summary_text,
        highlights,
      },
      { onConflict: 'user_id,week_start' }
    )
    .select()
    .single();

  if (error) {
    return NextResponse.json({ error: { message: error.message } }, { status: 500 });
  }

  return NextResponse.json({ data });
}


// ============================================
// lib/ai/generateSummary.ts
// ============================================
import { generateObject } from 'ai';
import { z } from 'zod';
import { MODEL } from './groq';

const summarySchema = z.object({
  summary_text: z.string(),
  highlights: z.array(z.string()),
});

export async function generateWeeklySummary({
  completedAssignments,
  masteredSkills,
}: {
  completedAssignments: string[];
  masteredSkills: string[];
}) {
  const { object } = await generateObject({
    model: MODEL,
    schema: summarySchema,
    prompt: `Write a short, encouraging 2-3 sentence weekly summary for a student, plus 2-4 short highlight bullet points.

Completed this week: ${completedAssignments.join(', ') || 'nothing logged'}
Skills mastered this week: ${masteredSkills.join(', ') || 'nothing logged'}

If nothing was completed, gently encourage getting started rather than being negative.`,
  });

  return object;
}
