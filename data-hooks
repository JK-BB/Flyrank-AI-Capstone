// Example usage — app/(app)/courses/[id]/page.tsx
// ============================================
'use client';

import { useAssignments } from '@/hooks/useAssignments';
import { Board } from '@/components/kanban/Board';

export default function CourseBoardPage({ params }: { params: { id: string } }) {
  const { assignments, loading, error, updateStatus, requestBreakdown } =
    useAssignments(params.id);

  if (loading) return <p className="text-sm text-muted-foreground">Loading board…</p>;
  if (error) return <p className="text-sm text-red-600">{error}</p>;

  return (
    <div>
      <h1 className="text-lg font-semibold mb-4">Assignments</h1>
      <Board items={assignments} onStatusChange={updateStatus} />
      {/* Wire a "Break down" button on each card to call requestBreakdown(card.id) */}
    </div>
  );
}
